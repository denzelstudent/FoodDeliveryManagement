@page "/riders/create"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Rider</PageTitle>

<h1>Create Rider</h1>
<hr />

<div class="container">
    <div class="row">
        <div class="col-12 col-md-6">
            <EditForm Model="Rider" OnValidSubmit="AddRider" FormName="rider-create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Rider.Name" class="form-control" />
                    <ValidationMessage For="() => Rider.Name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="vehicletype" class="form-label">Vehicle Type:</label>
                    <InputText id="vehicletype" @bind-Value="Rider.VehicleType" class="form-control" />
                    <ValidationMessage For="() => Rider.VehicleType" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="contacts" class="form-label">Contacts:</label>
                    <InputText id="contacts" @bind-Value="Rider.Contacts" class="form-control" />
                    <ValidationMessage For="() => Rider.Contacts" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="availabilitystatus" class="form-label">Availability Status:</label>
                    <InputText id="availabilitystatus" @bind-Value="Rider.AvailabilityStatus" class="form-control" />
                    <ValidationMessage For="() => Rider.AvailabilityStatus" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="/riders">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Rider Rider { get; set; } = new Rider
    {
        Name = string.Empty,
        VehicleType = string.Empty,
        Contacts = string.Empty,
        AvailabilityStatus = string.Empty,
        DateCreated = DateTime.Now,
        DateUpdated = DateTime.Now,
        CreatedBy = "System",
        UpdatedBy = "System"
    };

    private async Task AddRider()
    {
        using var context = DbFactory.CreateDbContext();

        // Set timestamps & system user
        Rider.DateCreated = DateTime.Now;
        Rider.DateUpdated = DateTime.Now;
        Rider.CreatedBy = "System";
        Rider.UpdatedBy = "System";

        context.Rider.Add(Rider);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/riders");
    }
}


}
