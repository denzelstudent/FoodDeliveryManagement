@page "/vendors/delete"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Vendor</h2>
    <hr />
    @if (vendor is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@vendor.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Address</dt>
            <dd class="col-sm-10">@vendor.Address</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Contacts</dt>
            <dd class="col-sm-10">@vendor.Contacts</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">OperatingHours</dt>
            <dd class="col-sm-10">@vendor.OperatingHours</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@vendor.DateCreated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@vendor.DateUpdated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@vendor.CreatedBy</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@vendor.UpdatedBy</dd>
        </dl>
        <EditForm method="post" Model="vendor" OnValidSubmit="DeleteVendor" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(vendor is null)">Delete</button> |
            <a href="/vendors">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Vendor? vendor;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        vendor = await context.Vendor.FirstOrDefaultAsync(m => m.Id == Id);

        if (vendor is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteVendor()
    {
        using var context = DbFactory.CreateDbContext();
        context.Vendor.Remove(vendor!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/vendors");
    }
}
