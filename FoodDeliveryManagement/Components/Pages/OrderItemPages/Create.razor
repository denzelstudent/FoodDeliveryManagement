@page "/orderitems/create"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>

<h2>OrderItem</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="OrderItem" OnValidSubmit="AddOrderItem" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert"/>
            <div class="mb-3">
                <label for="price" class="form-label">Price:</label> 
                <InputNumber id="price" @bind-Value="OrderItem.Price" class="form-control" /> 
                <ValidationMessage For="() => OrderItem.Price" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="quantity" class="form-label">Quantity:</label> 
                <InputNumber id="quantity" @bind-Value="OrderItem.Quantity" class="form-control" /> 
                <ValidationMessage For="() => OrderItem.Quantity" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="orderid" class="form-label">Order:</label>
                <InputSelect id="orderid" class="form-select" @bind-Value="OrderItem.OrderId">
                    <option value="0">-- Select Order --</option>
                    @foreach (var o in Orders)
                    {
                        <option value="@o.Id">@($"#{o.Id} - {o.OrderStatus}")</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => OrderItem.OrderId" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="itemid" class="form-label">Item:</label>
                <InputSelect id="itemid" class="form-select" @bind-Value="OrderItem.ItemId">
                    <option value="0">-- Select Item --</option>
                    @foreach (var i in ItemsList)
                    {
                        <option value="@i.Id">@($"{i.Name} - {i.Price}")</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => OrderItem.ItemId" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="datecreated" class="form-label">DateCreated:</label> 
                <InputDate id="datecreated" @bind-Value="OrderItem.DateCreated" class="form-control" /> 
                <ValidationMessage For="() => OrderItem.DateCreated" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="dateupdated" class="form-label">DateUpdated:</label> 
                <InputDate id="dateupdated" @bind-Value="OrderItem.DateUpdated" class="form-control" /> 
                <ValidationMessage For="() => OrderItem.DateUpdated" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="createdby" class="form-label">CreatedBy:</label> 
                <InputText id="createdby" @bind-Value="OrderItem.CreatedBy" class="form-control" /> 
                <ValidationMessage For="() => OrderItem.CreatedBy" class="text-danger" /> 
            </div>        
            <div class="mb-3">
                <label for="updatedby" class="form-label">UpdatedBy:</label> 
                <InputText id="updatedby" @bind-Value="OrderItem.UpdatedBy" class="form-control" /> 
                <ValidationMessage For="() => OrderItem.UpdatedBy" class="text-danger" /> 
            </div>        
            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/orderitems">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private OrderItem OrderItem { get; set; } = new();
    private List<Order> Orders { get; set; } = new();
    private List<Items> ItemsList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        Orders = await context.Order
            .AsNoTracking()
            .OrderByDescending(o => o.OrderTime)
            .ToListAsync();

        ItemsList = await context.Items
            .AsNoTracking()
            .OrderBy(i => i.Name)
            .ToListAsync();
    }


    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddOrderItem()
    {
        using var context = DbFactory.CreateDbContext();
        context.OrderItem.Add(OrderItem);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/orderitems");
    }
}
