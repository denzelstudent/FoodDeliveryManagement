@page "/items/create"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Create</h1>
<h2>Menu Item</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <EditForm Model="Items" OnValidSubmit="AddItems" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="mb-3">
                <label for="name" class="form-label">Name:</label>
                <InputText id="name" @bind-Value="Items.Name" class="form-control" />
                <ValidationMessage For="() => Items.Name" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="price" class="form-label">Price:</label>
                <InputNumber id="price" @bind-Value="Items.Price" class="form-control" />
                <ValidationMessage For="() => Items.Price" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="itemdescription" class="form-label">Item Description:</label>
                <InputText id="itemdescription" @bind-Value="Items.ItemDescription" class="form-control" />
                <ValidationMessage For="() => Items.ItemDescription" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="vendorid" class="form-label">Vendor:</label>
                <InputSelect id="vendorid" class="form-select" @bind-Value="Items.VendorId">
                    <option value="">-- Select Vendor --</option>
                    @foreach (var v in Vendors)
                    {
                        <option value="@v.Id">@v.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Items.VendorId" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div>
    <a href="/items">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Items Items { get; set; } = new();
    private List<Vendor> Vendors { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Vendors = await context.Vendor.AsNoTracking()
            .OrderBy(v => v.Name)
            .ToListAsync();

        // Default timestamps and system user
        Items.DateCreated = DateTime.Now;
        Items.DateUpdated = DateTime.Now;
        Items.CreatedBy = "System";
        Items.UpdatedBy = "System";
    }

    private async Task AddItems()
    {
        if (Items.VendorId == 0 || Items.VendorId == null)
        {
            // Show validation or prevent submission
            return;
        }

        using var context = DbFactory.CreateDbContext();
        Items.DateCreated = DateTime.Now;
        Items.DateUpdated = DateTime.Now;
        Items.CreatedBy = "System";
        Items.UpdatedBy = "System";

        context.Items.Add(Items);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/items");
    }
}



}
