@page "/items/delete"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Delete</PageTitle>

<h1>Delete</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <h2>Items</h2>
    <hr />
    @if (items is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">Name</dt>
            <dd class="col-sm-10">@items.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">Price</dt>
            <dd class="col-sm-10">@items.Price</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">ItemDescription</dt>
            <dd class="col-sm-10">@items.ItemDescription</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">VendorId</dt>
            <dd class="col-sm-10">@items.VendorId</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateCreated</dt>
            <dd class="col-sm-10">@items.DateCreated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">DateUpdated</dt>
            <dd class="col-sm-10">@items.DateUpdated</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">CreatedBy</dt>
            <dd class="col-sm-10">@items.CreatedBy</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">UpdatedBy</dt>
            <dd class="col-sm-10">@items.UpdatedBy</dd>
        </dl>
        <EditForm method="post" Model="items" OnValidSubmit="DeleteItems" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(items is null)">Delete</button> |
            <a href="/items">Back to List</a>
        </EditForm>
    }
</div>

@code {
    private Items? items;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        items = await context.Items.FirstOrDefaultAsync(m => m.Id == Id);

        if (items is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteItems()
    {
        using var context = DbFactory.CreateDbContext();
        context.Items.Remove(items!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/items");
    }
}
