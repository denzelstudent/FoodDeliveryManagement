@page "/items/edit"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Items</h2>
<hr />
@if (Items is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Items" OnValidSubmit="UpdateItems" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Items.Id" value="@Items.Id" />
                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Items.Name" class="form-control" />
                    <ValidationMessage For="() => Items.Name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">Price:</label>
                    <InputNumber id="price" @bind-Value="Items.Price" class="form-control" />
                    <ValidationMessage For="() => Items.Price" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="itemdescription" class="form-label">ItemDescription:</label>
                    <InputText id="itemdescription" @bind-Value="Items.ItemDescription" class="form-control" />
                    <ValidationMessage For="() => Items.ItemDescription" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="vendorid" class="form-label">VendorId:</label>
                    <InputNumber id="vendorid" @bind-Value="Items.VendorId" class="form-control" />
                    <ValidationMessage For="() => Items.VendorId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="datecreated" class="form-label">DateCreated:</label>
                    <InputDate id="datecreated" @bind-Value="Items.DateCreated" class="form-control" />
                    <ValidationMessage For="() => Items.DateCreated" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="dateupdated" class="form-label">DateUpdated:</label>
                    <InputDate id="dateupdated" @bind-Value="Items.DateUpdated" class="form-control" />
                    <ValidationMessage For="() => Items.DateUpdated" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="createdby" class="form-label">CreatedBy:</label>
                    <InputText id="createdby" @bind-Value="Items.CreatedBy" class="form-control" />
                    <ValidationMessage For="() => Items.CreatedBy" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="updatedby" class="form-label">UpdatedBy:</label>
                    <InputText id="updatedby" @bind-Value="Items.UpdatedBy" class="form-control" />
                    <ValidationMessage For="() => Items.UpdatedBy" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/items">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Items? Items { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Items ??= await context.Items.FirstOrDefaultAsync(m => m.Id == Id);

        if (Items is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateItems()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Items!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ItemsExists(Items!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/items");
    }

    private bool ItemsExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Items.Any(e => e.Id == id);
    }
}
