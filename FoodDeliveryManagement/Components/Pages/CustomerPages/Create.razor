@page "/customers/create"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@using Microsoft.AspNetCore.Components.Forms
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Customer</PageTitle>

<h1>Create Customer</h1>
<hr />

<div class="container">
    <div class="row">
        <div class="col-12 col-md-6">
            <EditForm Model="Customer" OnValidSubmit="AddCustomer" FormName="customer-create" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" />

                <div class="mb-3">
                    <label for="name" class="form-label">Name:</label>
                    <InputText id="name" @bind-Value="Customer.Name" class="form-control" />
                    <ValidationMessage For="() => Customer.Name" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="address" class="form-label">Address:</label>
                    <InputText id="address" @bind-Value="Customer.Address" class="form-control" />
                    <ValidationMessage For="() => Customer.Address" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="contacts" class="form-label">Contacts:</label>
                    <InputText id="contacts" @bind-Value="Customer.Contacts" class="form-control" />
                    <ValidationMessage For="() => Customer.Contacts" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="paymentinformation" class="form-label">Payment Information:</label>
                    <InputText id="paymentinformation" @bind-Value="Customer.PaymentInformation" class="form-control" />
                    <ValidationMessage For="() => Customer.PaymentInformation" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
            </EditForm>
        </div>
    </div>
</div>

<div class="mt-3">
    <a href="/customers">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Customer Customer { get; set; } = new Customer
    {
        Name = string.Empty,
        Address = string.Empty,
        Contacts = string.Empty,
        PaymentInformation = string.Empty,
        DateCreated = DateTime.Now,
        DateUpdated = DateTime.Now,
        CreatedBy = "System",
        UpdatedBy = "System"
    };

    private async Task AddCustomer()
    {
        using var context = DbFactory.CreateDbContext();

        // Ensure timestamps & system user are set
        Customer.DateCreated = DateTime.Now;
        Customer.DateUpdated = DateTime.Now;
        Customer.CreatedBy = "System";
        Customer.UpdatedBy = "System";

        context.Customer.Add(Customer);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/customers");
    }
}

