@page "/rewards"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Rewards</PageTitle>

<h1>Rewards</h1>
<a class="btn btn-primary mb-3" href="/rewards/create">Create New</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Code</th>
            <th>Reward Type</th>
            <th>Reward Amount</th>
            <th>Customer</th>
            <th>Date Created</th>
            <th>Date Updated</th>
            <th>Created By</th>
            <th>Updated By</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var reward in Rewards)
        {
            <tr>
                <td>@reward.Code</td>
                <td>@reward.RewardType</td>
                <td>@reward.RewardAmount</td>
                <td>@reward.Customer?.Name</td>
                <td>@reward.DateCreated.ToString("dd/MM/yyyy")</td>
                <td>@reward.DateUpdated.ToString("dd/MM/yyyy")</td>
                <td>@reward.CreatedBy</td>
                <td>@reward.UpdatedBy</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<Reward> Rewards { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Rewards = await context.Reward
            .Include(r => r.Customer)  // Load the related Customer entity
            .AsNoTracking()
            .OrderByDescending(r => r.DateCreated)
            .ToListAsync();
    }
}

