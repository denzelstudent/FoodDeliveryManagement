@page "/rewards/edit"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Reward</h2>
<hr />
@if (Reward is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Reward" OnValidSubmit="UpdateReward" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Reward.Id" value="@Reward.Id" />
                <div class="mb-3">
                    <label for="code" class="form-label">Code:</label>
                    <InputText id="code" @bind-Value="Reward.Code" class="form-control" />
                    <ValidationMessage For="() => Reward.Code" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="rewardtype" class="form-label">RewardType:</label>
                    <InputText id="rewardtype" @bind-Value="Reward.RewardType" class="form-control" />
                    <ValidationMessage For="() => Reward.RewardType" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="rewardamount" class="form-label">RewardAmount:</label>
                    <InputNumber id="rewardamount" @bind-Value="Reward.RewardAmount" class="form-control" />
                    <ValidationMessage For="() => Reward.RewardAmount" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="customerid" class="form-label">CustomerId:</label>
                    <InputNumber id="customerid" @bind-Value="Reward.CustomerId" class="form-control" />
                    <ValidationMessage For="() => Reward.CustomerId" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="datecreated" class="form-label">DateCreated:</label>
                    <InputDate id="datecreated" @bind-Value="Reward.DateCreated" class="form-control" />
                    <ValidationMessage For="() => Reward.DateCreated" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="dateupdated" class="form-label">DateUpdated:</label>
                    <InputDate id="dateupdated" @bind-Value="Reward.DateUpdated" class="form-control" />
                    <ValidationMessage For="() => Reward.DateUpdated" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="createdby" class="form-label">CreatedBy:</label>
                    <InputText id="createdby" @bind-Value="Reward.CreatedBy" class="form-control" />
                    <ValidationMessage For="() => Reward.CreatedBy" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="updatedby" class="form-label">UpdatedBy:</label>
                    <InputText id="updatedby" @bind-Value="Reward.UpdatedBy" class="form-control" />
                    <ValidationMessage For="() => Reward.UpdatedBy" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/rewards">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Reward? Reward { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Reward ??= await context.Reward.FirstOrDefaultAsync(m => m.Id == Id);

        if (Reward is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateReward()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Reward!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!RewardExists(Reward!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/rewards");
    }

    private bool RewardExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Reward.Any(e => e.Id == id);
    }
}
