@page "/rewards/create"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Reward</PageTitle>

<h1>Create</h1>
<h2>Reward</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <EditForm Model="Reward" OnValidSubmit="AddReward" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="code" class="form-label">Code:</label>
                <InputText id="code" @bind-Value="Reward.Code" class="form-control" />
                <ValidationMessage For="() => Reward.Code" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="rewardtype" class="form-label">Reward Type:</label>
                <InputText id="rewardtype" @bind-Value="Reward.RewardType" class="form-control" />
                <ValidationMessage For="() => Reward.RewardType" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="rewardamount" class="form-label">Reward Amount:</label>
                <InputNumber id="rewardamount" @bind-Value="Reward.RewardAmount" class="form-control" />
                <ValidationMessage For="() => Reward.RewardAmount" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="customerid" class="form-label">Customer:</label>
                <InputSelect id="customerid" class="form-select" @bind-Value="Reward.CustomerId">
                    <option value="0">-- Select Customer --</option>
                    @foreach (var c in Customers)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Reward.CustomerId" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div class="mt-3">
    <a href="/rewards">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Reward Reward { get; set; } = new();
    private List<Customer> Customers { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Customers = await context.Customer
            .AsNoTracking()
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private async Task AddReward()
    {
        if (Reward.CustomerId == 0)
        {
            return; // prevent saving without selecting a customer
        }

        using var context = DbFactory.CreateDbContext();

        Reward.DateCreated = DateTime.Now;
        Reward.DateUpdated = DateTime.Now;
        Reward.CreatedBy = "System";
        Reward.UpdatedBy = "System";

        context.Reward.Add(Reward);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/rewards", forceLoad: true);
    }
}


