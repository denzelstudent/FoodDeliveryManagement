@page "/payments/create"
@using Microsoft.EntityFrameworkCore
@using FoodDeliveryManagement.Domain
@inject IDbContextFactory<FoodDeliveryManagement.Data.FoodDeliveryManagementContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create Payment</PageTitle>

<h1>Create</h1>
<h2>Payment</h2>
<hr />

<div class="row">
    <div class="col-md-4">
        <EditForm Model="Payment" OnValidSubmit="AddPayment" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" />

            <div class="mb-3">
                <label for="paymentmethod" class="form-label">Payment Method:</label>
                <InputText id="paymentmethod" @bind-Value="Payment.PaymentMethod" class="form-control" />
                <ValidationMessage For="() => Payment.PaymentMethod" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="amount" class="form-label">Amount:</label>
                <InputNumber id="amount" @bind-Value="Payment.Amount" class="form-control" />
                <ValidationMessage For="() => Payment.Amount" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="orderid" class="form-label">Order:</label>
                <InputSelect id="orderid" class="form-select" @bind-Value="Payment.OrderId">
                    <option value="0">-- Select Order --</option>
                    @foreach (var o in OrdersWithoutPayment)
                    {
                        <option value="@o.Id">@($"#{o.Id} - {o.OrderStatus}")</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => Payment.OrderId" class="text-danger" />
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
        </EditForm>
    </div>
</div>

<div class="mt-3">
    <a href="/payments">Back to List</a>
</div>

@code {
    [SupplyParameterFromForm]
    private Payment Payment { get; set; } = new();
    private List<Order> OrdersWithoutPayment { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        // Only show orders that do NOT already have a payment
        OrdersWithoutPayment = await context.Order
            .Include(o => o.Payment)
            .Where(o => !context.Payment.Any(p => p.OrderId == o.Id))
            .AsNoTracking()
            .OrderByDescending(o => o.OrderTime)
            .ToListAsync();
    }

    private async Task AddPayment()
    {
        if (Payment.OrderId == 0)
            return; // prevent saving without selecting an order

        using var context = DbFactory.CreateDbContext();

        Payment.DateCreated = DateTime.Now;
        Payment.DateUpdated = DateTime.Now;
        Payment.CreatedBy = "System";
        Payment.UpdatedBy = "System";

        context.Payment.Add(Payment);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo("/payments", forceLoad: true);
    }
}


}
